#include "LiquidCrystal_I2C.h"

#define I2C_ADDR    0x27
#define LCD_COLUMNS 20
#define LCD_LINES   4

LiquidCrystal_I2C lcd(I2C_ADDR, LCD_COLUMNS, LCD_LINES);

void setup() {
  Serial.begin(115200);
  Serial.println("Hello, ABINAYA!");

  lcd.init();
  lcd.backlight();

  lcd.setCursor(4, 0);
  lcd.print("Hello, ABI");
  lcd.setCursor(5, 2);
  lcd.print("Welcome to");
  lcd.setCursor(7, 3);
  lcd.print("LIVEWIRE!");
}

void loop() {
}
